<!-- =============================================
     TRANG CHỦ - Hiển thị bài viết theo phân mục
     ============================================= -->

<!-- SECTION 1: BÀI VIẾT MỚI NHẤT -->
<div class="container-fluid pt-5 mb-3">
    <div class="container">
        <div class="section-title">
            <h4 class="m-0 text-uppercase font-weight-bold">
                <i class="fas fa-bolt text-primary mr-2"></i>Mới nhất
            </h4>
        </div>
        <div class="row">
            <% if(latestNews && latestNews.length> 0) { %>
                <!-- Bài viết nổi bật (bài đầu tiên, hiển thị lớn) -->
                <div class="col-lg-6 mb-4">
                    <div class="position-relative overflow-hidden" style="height: 100%; min-height: 400px;">
                        <img class="img-fluid w-100 h-100" src="/client/img/<%= latestNews[0].image %>"
                            alt="<%= latestNews[0].title %>" style="object-fit: cover;">
                        <div class="overlay position-absolute w-100"
                            style="bottom: 0; left: 0; background: linear-gradient(transparent, rgba(0,0,0,0.85)); padding: 25px;">
                            <span class="badge badge-primary text-uppercase p-2 mb-2">
                                <%= latestNews[0].category_name %>
                            </span>
                            <a class="h3 text-white d-block mb-2" href="/tin-tuc/<%= latestNews[0].id %>">
                                <%= latestNews[0].title %>
                            </a>
                            <p class="text-white-50 mb-0">
                                <small><i class="far fa-calendar-alt mr-1"></i>
                                    <%= new Date(latestNews[0].created_at).toLocaleDateString('vi-VN') %>
                                </small>
                                <small class="ml-3"><i class="far fa-eye mr-1"></i>
                                    <%= latestNews[0].views || 0 %> lượt xem
                                </small>
                            </p>
                        </div>
                    </div>
                </div>
                <!-- Các bài viết còn lại -->
                <div class="col-lg-6">
                    <div class="row">
                        <% latestNews.slice(1, 5).forEach(news=> { %>
                            <div class="col-md-6 mb-4">
                                <div class="bg-white border" style="height: 100%;">
                                    <div style="height: 160px; overflow: hidden;">
                                        <img src="/client/img/<%= news.image %>" alt="<%= news.title %>"
                                            class="img-fluid w-100" style="height: 100%; object-fit: cover;">
                                    </div>
                                    <div class="p-3">
                                        <span class="badge badge-primary text-uppercase mb-2">
                                            <%= news.category_name %>
                                        </span>
                                        <a class="font-weight-bold d-block mb-2" href="/tin-tuc/<%= news.id %>"
                                            style="font-size: 14px; height: 40px; overflow: hidden; color: #333;">
                                            <%= news.title %>
                                        </a>
                                        <small class="text-muted">
                                            <i class="far fa-calendar-alt mr-1"></i>
                                            <%= new Date(news.created_at).toLocaleDateString('vi-VN') %>
                                        </small>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                </div>
                <% } else { %>
                    <div class="col-12">
                        <p class="text-muted text-center py-5">Chưa có bài viết nào.</p>
                    </div>
                    <% } %>
        </div>
    </div>
</div>

<!-- SECTION 2: BÀI VIẾT XEM NHIỀU NHẤT -->
<div class="container-fluid py-3">
    <div class="container">
        <div class="section-title">
            <h4 class="m-0 text-uppercase font-weight-bold">
                <i class="fas fa-fire text-danger mr-2"></i>Xem nhiều nhất
            </h4>
        </div>
        <div class="row">
            <% if(mostViewedNews && mostViewedNews.length> 0) { %>
                <% let sortedNews=mostViewedNews.sort((a, b)=> (b.views || 0) - (a.views || 0));
                    %>
                    <% sortedNews.forEach(news=> { %>
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="bg-white border p-0 h-100 shadow-sm" style="transition: transform 0.2s;">
                                <div style="height: 200px; overflow: hidden;">
                                    <img src="/client/img/<%= news.image %>" alt="<%= news.title %>"
                                        class="img-fluid w-100" style="height: 100%; object-fit: cover;">
                                </div>
                                <div class="p-3">
                                    <div class="mb-2">
                                        <span class="badge badge-warning text-dark text-uppercase">
                                            <%= news.category_name %>
                                        </span>
                                        <small class="text-muted ml-2">
                                            <i class="far fa-calendar-alt mr-1"></i>
                                            <%= new Date(news.created_at).toLocaleDateString('vi-VN') %>
                                        </small>
                                    </div>
                                    <a class="font-weight-bold d-block mb-2" href="/tin-tuc/<%= news.id %>"
                                        style="font-size: 16px; height: 48px; overflow: hidden; color: #333; text-decoration: none;">
                                        <%= news.title %>
                                    </a>
                                    <p class="text-muted mb-2" style="font-size: 14px; height: 42px; overflow: hidden;">
                                        <%= news.summary %>
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <a href="/tin-tuc/<%= news.id %>"
                                            class="btn btn-sm btn-warning font-weight-bold">Đọc tiếp</a>
                                        <small class="text-muted"><i class="far fa-eye mr-1"></i>
                                            <%= news.views || 0 %> lượt xem
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="col-12">
                                    <p class="text-muted text-center py-5">Chưa có bài viết nào.</p>
                                </div>
                                <% } %>
        </div>
    </div>
</div>

<!-- SECTION 3: BÀI VIẾT THEO TỪNG CHUYÊN MỤC -->
<% if(newsByCategory && newsByCategory.length> 0) { %>
    <% newsByCategory.forEach(group=> { %>
        <div class="container-fluid py-3">
            <div class="container">
                <div class="section-title">
                    <h4 class="m-0 text-uppercase font-weight-bold">
                        <%= group.category.name %>
                    </h4>
                    <a class="text-secondary font-weight-medium text-decoration-none"
                        href="/chuyen-muc/<%= group.category.id %>">
                        Xem tất cả
                    </a>
                </div>
                <div class="row">
                    <% group.articles.forEach(news=> { %>
                        <div class="col-lg-3 col-md-6 mb-4">
                            <div class="bg-white border h-100 shadow-sm">
                                <div style="height: 160px; overflow: hidden;">
                                    <img src="/client/img/<%= news.image %>" alt="<%= news.title %>"
                                        class="img-fluid w-100" style="height: 100%; object-fit: cover;">
                                </div>
                                <div class="p-3">
                                    <a class="font-weight-bold d-block mb-2" href="/tin-tuc/<%= news.id %>"
                                        style="font-size: 14px; height: 40px; overflow: hidden; color: #333; text-decoration: none;">
                                        <%= news.title %>
                                    </a>
                                    <small class="text-muted">
                                        <i class="far fa-calendar-alt mr-1"></i>
                                        <%= new Date(news.created_at).toLocaleDateString('vi-VN') %>
                                    </small>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
        </div>
        <% }) %>
            <% } %>
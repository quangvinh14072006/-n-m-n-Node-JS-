<!-- Footer Start -->
<div class="container-fluid bg-dark pt-5 px-sm-3 px-md-5 mt-5">
    <div class="row py-4">
        <div class="col-lg-3 col-md-6 mb-5">
            <h5 class="mb-4 text-white text-uppercase font-weight-bold">Liên hệ</h5>
            <p class="font-weight-medium"><i class="fa fa-map-marker-alt mr-2"></i>
                <%= typeof websiteInfo !== 'undefined' && websiteInfo ? websiteInfo.address : '123 Đường ABC, TP.HCM' %>
            </p>
            <p class="font-weight-medium"><i class="fa fa-phone-alt mr-2"></i>
                <%= typeof websiteInfo !== 'undefined' && websiteInfo ? websiteInfo.phone : '0123 456 789' %>
            </p>
            <p class="font-weight-medium"><i class="fa fa-envelope mr-2"></i>
                <%= typeof websiteInfo !== 'undefined' && websiteInfo ? websiteInfo.email : 'info@biznews.com' %>
            </p>
            <h6 class="mt-4 mb-3 text-white text-uppercase font-weight-bold">Theo dõi chúng tôi</h6>
            <div class="d-flex justify-content-start">
                <a class="btn btn-lg btn-secondary btn-lg-square mr-2" href="<%= typeof websiteInfo !== 'undefined' && websiteInfo ? websiteInfo.facebook : '#' %>"><i class="fab fa-facebook-f"></i></a>
                <a class="btn btn-lg btn-secondary btn-lg-square mr-2" href="<%= typeof websiteInfo !== 'undefined' && websiteInfo ? websiteInfo.youtube : '#' %>"><i class="fab fa-youtube"></i></a>
                <a class="btn btn-lg btn-secondary btn-lg-square mr-2" href="<%= typeof websiteInfo !== 'undefined' && websiteInfo ? websiteInfo.twitter : '#' %>"><i class="fab fa-twitter"></i></a>
                <a class="btn btn-lg btn-secondary btn-lg-square" href="<%= typeof websiteInfo !== 'undefined' && websiteInfo ? websiteInfo.instagram : '#' %>"><i class="fab fa-instagram"></i></a>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-5">
            <h5 class="mb-4 text-white text-uppercase font-weight-bold">Chuyên mục</h5>
            <div class="m-n1">
                <% if(typeof categories !== 'undefined' && categories) { %>
                    <% categories.forEach(cat => { %>
                        <a href="/chuyen-muc/<%= cat.id %>" class="btn btn-sm btn-secondary m-1"><%= cat.name %></a>
                    <% }) %>
                <% } %>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-5">
            <h5 class="mb-4 text-white text-uppercase font-weight-bold">Đường dẫn nhanh</h5>
            <div class="d-flex flex-column justify-content-start">
                <a class="text-secondary mb-2" href="/"><i class="fa fa-angle-right mr-2"></i>Trang chủ</a>
                <a class="text-secondary mb-2" href="/tin-tuc"><i class="fa fa-angle-right mr-2"></i>Tin tức</a>
                <a class="text-secondary mb-2" href="/lien-he"><i class="fa fa-angle-right mr-2"></i>Liên hệ</a>
                <a class="text-secondary" href="/admin/dang-nhap"><i class="fa fa-angle-right mr-2"></i>Đăng nhập</a>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-5">
            <h5 class="mb-4 text-white text-uppercase font-weight-bold">Đăng ký nhận tin</h5>
            <p>Nhập email để nhận thông báo khi có tin tức mới.</p>
            <div class="input-group mb-2" style="width: 100%;">
                <input type="email" id="subscribe-email" class="form-control form-control-lg" placeholder="Email của bạn">
                <div class="input-group-append">
                    <button id="subscribe-btn" class="btn btn-primary font-weight-bold px-3">Đăng ký</button>
                </div>
            </div>
            <small id="subscribe-msg" class="text-success" style="display:none;"></small>
        </div>
    </div>
</div>
<div class="container-fluid py-4 px-sm-3 px-md-5" style="background: #111111;">
    <p class="m-0 text-center">
        <%= typeof websiteInfo !== 'undefined' && websiteInfo ? websiteInfo.copyright : '© 2026 BizNews. All Rights Reserved.' %>
    </p>
</div>
<!-- Footer End -->

<!-- Back to Top -->
<a href="#" class="btn btn-primary btn-square back-to-top"><i class="fa fa-arrow-up"></i></a>

<!-- Contact Popup -->
<button id="contact-popup-btn" class="btn btn-danger rounded-circle shadow-lg"
    style="position: fixed; bottom: 80px; right: 30px; width: 60px; height: 60px; font-size: 24px; z-index: 999;">
    <i class="fa fa-envelope"></i>
</button>

<!-- Contact Modal -->
<div class="modal fade" id="contactModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white font-weight-bold">Liên hệ nhanh</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form action="/lien-he" method="POST">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Họ tên <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="form-row">
                        <div class="col-md-6 form-group">
                            <label>Email <span class="text-danger">*</span></label>
                            <input type="email" name="email" class="form-control" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Số điện thoại</label>
                            <input type="text" name="phone" class="form-control">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Tiêu đề</label>
                        <input type="text" name="subject" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>Nội dung <span class="text-danger">*</span></label>
                        <textarea name="message" class="form-control" rows="4" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Gửi liên hệ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript Libraries -->
<script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
<script src="/client/lib/easing/easing.min.js"></script>
<script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>
<script src="/client/js/main.js"></script>

<script>
// Xử lý nút popup liên hệ
document.getElementById('contact-popup-btn').addEventListener('click', function() {
    $('#contactModal').modal('show');
});

// Xử lý đăng ký nhận tin
document.getElementById('subscribe-btn').addEventListener('click', function() {
    const email = document.getElementById('subscribe-email').value;
    const msgEl = document.getElementById('subscribe-msg');
    
    if (!email) {
        msgEl.textContent = 'Vui lòng nhập email!';
        msgEl.className = 'text-danger';
        msgEl.style.display = 'block';
        return;
    }

    fetch('/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email })
    })
    .then(res => res.json())
    .then(data => {
        msgEl.textContent = data.message;
        msgEl.className = data.success ? 'text-success' : 'text-danger';
        msgEl.style.display = 'block';
        if (data.success) {
            document.getElementById('subscribe-email').value = '';
        }
    })
    .catch(() => {
        msgEl.textContent = 'Có lỗi xảy ra!';
        msgEl.className = 'text-danger';
        msgEl.style.display = 'block';
    });
});
</script>

</body>
</html>